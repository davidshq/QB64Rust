# Rust build output (also the legacy test runner's results, target/legacy-tests/)
/target/

# insta's pending snapshots, written by test runs (`cargo insta review` takes them)
*.pending-snap
*.snap.new

# Python
__pycache__/

# qb64rust's build folders, next to the executable (`<exe>.qb64rust/`; `-z` and `--keep-build` leave them)
*.qb64rust/

# The libqb objects builds write in the copy of libqb (design D1 of libqb-copy)
/libqb/**/*.o
/libqb/**/*.a
/libqb/**/*.tmp
# What those objects were built with (design D2 of libqb-object-flags)
/libqb/objects.stamp
# The lock of those objects when no QB64RUST_OBJECTS_LOCK is set (m6-compiler-download)
/libqb/objects.lock

# Compiled verification programs
/verification/*.exe
# Libraries built by verification/v37_lib/build_libs.py
/verification/*.a
/verification/*.o
/verification/*.dll
/verification/*.so

# QB64pe wiki cache: no licence stated, local reference only (CLAUDE.md)
/tools/wiki/cache/

# VS Code extension
/vscode/node_modules/
/vscode/out/
/vscode/.vscode-test/
/vscode/*.vsix
# What the platform .vsix carries, written by vscode/scripts/stage_bundle.py
/vscode/bundle/
/vscode/LICENSE
/vscode/*.tsbuildinfo
/vscode/test-fixtures/**/*.exe

# OS and editor clutter
Thumbs.db
desktop.ini
.DS_Store
*.log
