# Recorded program output and compiler output: keep the bytes exactly as recorded (tests/corpus/README.md)
tests/corpus/**/*.output -text
tests/corpus/**/*.err -text
# Standard input of a program that reads the console: given to it byte for byte (tests/corpus/README.md)
tests/corpus/**/*.stdin -text
verification/*.stdin -text
# The files the $EMBED measurements embed: byte for byte (verification/README.md, v44)
verification/v44_files/** -text
# The copy of QB64pe's afterlastline.bm the compiler compiles (design D7 of m3-network-embed): byte for byte
crates/builtins/src/afterlastline.bm -text
# The recorded state of a screen program and the keys it is given (tools/screen/README.md)
tests/corpus/**/*.screen -text
tests/corpus/**/*.keys -text
# The data files a corpus program reads, copied beside it when it runs: byte for byte (tools/legacy_tests/README.md)
tests/corpus/**/*.files/** -text
# Recorded verification output: text is stored with LF on every machine, whatever its git settings; a file git
# takes for binary (a NUL, a CR without LF) keeps its bytes (tools/legacy_tests/README.md, "Verification programs")
verification/*.compile.txt text=auto
verification/*.out.txt text=auto
# Resource fixtures match the old compiler's CRLF output byte for byte, including in CI.
verification/v40_rc/*.manifest text eol=crlf
verification/v40_rc/*.manifest.h text eol=crlf
verification/v40_rc/*.icon.rc text eol=crlf
# Differential programs: tier 1 compares them byte for byte with the generator; their recorded output as recorded
tests/differential/**/*.bas -text
tests/differential/**/*.output -text
tests/differential/**/*.err -text
# CP437 bytes and CRLF line ends are the point of this program (design D2 of m2-workspace-and-slice)
tests/corpus/slice/s07_cp437_bytes.bas -text
# Copy of QB64pe's libqb: the commit's bytes and line ends (design D1 of libqb-copy, tools/libqb/copy_libqb.py)
libqb/** -text
# Copy of QB64pe's compile tests: keep upstream's bytes and line ends (design D1 of m2-upstream-tests)
tests/upstream/compile_tests/**/*.bas -text
tests/upstream/compile_tests/**/*.bi -text
tests/upstream/compile_tests/**/*.bm -text
tests/upstream/compile_tests/**/*.output -text
tests/upstream/compile_tests/**/*.err -text
tests/upstream/compile_tests/**/*.license -text
# QB64Fresh snippets: CR LF sources and qb64pe's output as recorded (design D5 of m2-upstream-tests)
tests/snippets/**/*.bas -text
tests/snippets/**/*.err -text
# The language server's encoding fixtures: raw bytes, CR and LF among them (tools/encodings/gen_tables.js)
crates/lsp/tests/fixtures/*.bin -text
# Real programs taken whole: source, data and image files byte for byte (tests/programs/README.md)
tests/programs/civil-war-strategy/** -text
tests/programs/civil-war-strategy/SOURCE.md text
# The copy of the game for its scripted game (tools/screen/cut_game.py): the game's lines byte for byte, CP437
