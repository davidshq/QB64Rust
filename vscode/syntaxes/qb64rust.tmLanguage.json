        "0": {
          "name": "punctuation.definition.string.end.qb64rust"
        }
      }
    },
    "metacommand-in-comment": {
      "patterns": [
        {
          "name": "meta.preprocessor.metacommand.qb64rust",
          "match": "(?i)(')\\s*(\\$[A-Z_][A-Z0-9_]*)(.*)$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.qb64rust"
            },
            "2": {
              "name": "keyword.control.directive.metacommand.qb64rust"
            },
            "3": {
              "patterns": [
                {
                  "include": "#metacommand-argument"
                }
              ]
            }
          }
        },
        {
          "name": "meta.preprocessor.metacommand.qb64rust",
          "match": "(?i)(?:^|(?<=:))\\s*(REM)\\s+(\\$[A-Z_][A-Z0-9_]*)(.*)$",
          "captures": {
            "1": {
              "name": "keyword.other.rem.qb64rust"
            },
            "2": {
              "name": "keyword.control.directive.metacommand.qb64rust"
            },
            "3": {
              "patterns": [
                {
                  "include": "#metacommand-argument"
                }
              ]
            }
          }
        }
      ]
    },
    "metacommand-argument": {
      "patterns": [
        {
          "name": "string.quoted.single.qb64rust",
          "match": "'[^']*'"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.qb64rust",
          "match": "(').*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.qb64rust"
            }
          }
        },
        {
          "match": "(?i)(?:^\\s*(?:\\d+\\s+)?|(?<=:)\\s*)((REM)(?![\\w.$%&!#~`]).*$)",
          "captures": {
            "1": {
              "name": "comment.line.rem.qb64rust"
            },
            "2": {
              "name": "keyword.other.rem.qb64rust"
            }
          }
        }
      ]
