    "number": {
      "patterns": [
        {
          "name": "constant.numeric.radix.qb64rust",
          "match": "(?i)&(?:H[0-9A-F]+|O[0-7]+|B[01]+)(~?(?:%%|&&|%|&|`\\d*))?",
