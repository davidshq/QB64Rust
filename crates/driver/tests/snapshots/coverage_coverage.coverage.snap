static void qbr_cov_write(){
const char *qbr_path=getenv("QB64RUST_COVERAGE");
if (!qbr_path||!*qbr_path) return;
FILE *qbr_f=fopen(qbr_path,"ab");
if (!qbr_f) return;
fprintf(qbr_f,"coverage 1\n");
for (int32 qbr_i=0;qbr_i<1;qbr_i++) fprintf(qbr_f,"file\t%d\t%s\n",(int)qbr_i,qbr_cov_files[qbr_i]);
for (int32 qbr_i=0;qbr_i<20;qbr_i++) fprintf(qbr_f,"%u\t%u\t%u\t%u\n",(unsigned)qbr_cov_at[3*qbr_i],(unsigned)qbr_cov_at[3*qbr_i+1],(unsigned)qbr_cov_at[3*qbr_i+2],(unsigned)qbr_cov[qbr_i]);
fprintf(qbr_f,"end\n");
fclose(qbr_f);
}
static const int32 qbr_cov_registered=atexit(qbr_cov_write)|at_quick_exit(qbr_cov_write);
