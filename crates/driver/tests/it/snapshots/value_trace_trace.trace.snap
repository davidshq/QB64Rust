#define QBR_TRC_ENTRIES 14
#define QBR_TRC_FILES 1
#define QBR_TRC_ALIASES 1
#define QBR_TRC_UNTRACED 2
static const char *const qbr_trc_names[]={"K\011SINGLE\011-","A()\011LONG\011-","P.X\011INTEGER\011-","SHIPS().X\011INTEGER\011-","P.V()\011LONG\011-","Q.X\011INTEGER\011-","Q.V()\011LONG\011-","N()\011STRING\011-","C()\011LONG\011-","F\011STRING\011-","N\011SINGLE\011BUMP","B()\011LONG\011FILL","N\011SINGLE\011TWICE","TWICE\011SINGLE\011TWICE"};
