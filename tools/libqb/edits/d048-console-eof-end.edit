# END waits for a key only when standard input is a console (QB64PE-DIVERGENCES.md D-048, UPSTREAM.md "Console input
# waits for ever at the end of a redirected input"; study\39 row 2; DECISIONS.md 2026-10-27). QB64pe's END, in a
# console program with the window hidden, prints "Press any key to continue" and waits for a key-down event from the
# console, which a file, a pipe or the null device never gives (verification\v26_e_end, v22_x50: timed out). Here
# the line is still printed, as QB64pe on Linux prints its own and ends at EOF, and the wait runs only when
# GetConsoleMode succeeds on the input (the null device is a character device too, so GetFileType cannot tell).
file: internal/c/libqb.cpp
--- old
            std::cout << "\nPress any key to continue";
            int32 junk;
            FlushConsoleInputBuffer(GetStdHandle(STD_INPUT_HANDLE)); // clear any stray buffer events before we run END.
            do {                                                     // ignore all console input
                junk = func__getconsoleinput();
            } while (junk != 1); // until we have a key down event
--- new
            std::cout << "\nPress any key to continue";
            int32 junk;
            DWORD input_mode;
            if (GetConsoleMode(GetStdHandle(STD_INPUT_HANDLE), &input_mode)) { // a redirected input never sends a key
                FlushConsoleInputBuffer(GetStdHandle(STD_INPUT_HANDLE)); // clear any stray buffer events before we run END.
                do {                                                     // ignore all console input
                    junk = func__getconsoleinput();
                } while (junk != 1); // until we have a key down event
            }
--- end
