# BLOAD past the end of the block of conventional memory raises error 5 (QB64PE-DIVERGENCES.md D-049, UPSTREAM.md
# "BLOAD and BSAVE run past the block of conventional memory"; study\39 row 5). QB64pe's sub_bload reads the
# header's size, or the whole file when the size is 0 and the file is 64 KB or more, to its destination in cmem
# without checking the length, so a BLOAD near the top of the block writes into the process's memory after it
# (verification\v63_b1, b2, b4). Here the destination plus the length is checked against the block first, and error 5
# is raised before anything is read. Inside the block nothing changes.
file: internal/c/libqb.cpp
--- old
    if (passed) {
        fh.read((char *)(defseg + offset), file_size);
    } else {
        fh.read((char *)(&cmem[0] + file_seg * 16 + file_off), file_size);
    }
--- new
    {
        uint8 *dest = passed ? defseg + offset : &cmem[0] + file_seg * 16 + file_off;
        if ((dest - &cmem[0]) + (intptr_t)file_size > (intptr_t)sizeof(cmem)) {
            fh.close();
            error(5);
            return;
        }
        fh.read((char *)dest, file_size);
    }
--- end
