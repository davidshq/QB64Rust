# A string is never made with a negative length (DIVERGENCES-QB64PE.md D-067). A string's length is an int32_t, so a
# length computed past 2,147,483,647 wraps negative. QB64pe's qbs_new then moves the pool's place backwards and
# hands out memory of other strings, and the program crashes (verification\v63_g3_concat_over_2gb, exit 139).
# Here such a length raises error 5, "Illegal function call", as QB 4.5 does for a string past its own limit
# (verification\qb45\q45_string_too_long), and the string is empty. The callers that compute a length check it
# first (d067-string-add-too-long.edit, d067-readfile-too-long.edit); this catches any other.
# The 32 bytes added to the size are added unsigned: in an int32_t, size + 32 overflows (undefined in C++) for a
# string within 32 bytes of the longest one.
file: internal/c/libqb/src/qbs.cpp
--- old
qbs *qbs_new(int32_t size, uint8_t tmp) {
    static qbs *newstr;
    if ((qbs_sp + size + 32) > qbs_data_size)
        qbs_concat(size + 32);
    newstr = qbs_new_descriptor();
    newstr->len = size;
    newstr->chr = qbs_data + qbs_sp;
    qbs_sp += size + 32;
--- new
qbs *qbs_new(int32_t size, uint8_t tmp) {
    static qbs *newstr;
    if (size < 0) { // a length past 2,147,483,647 that wrapped
        error(QB_ERROR_ILLEGAL_FUNCTION_CALL);
        size = 0;
    }
    if ((qbs_sp + size + 32) > qbs_data_size)
        qbs_concat((uint32_t)size + 32); // unsigned: size + 32 overflows an int32_t near the limit
    newstr = qbs_new_descriptor();
    newstr->len = size;
    newstr->chr = qbs_data + qbs_sp;
    qbs_sp += (uint32_t)size + 32;
--- end
