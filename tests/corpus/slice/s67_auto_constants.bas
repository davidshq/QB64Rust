PRINT _INTEGER64_MAX&&; _UINTEGER64_MIN~&&; _OFFSET_MAX&&; _SINGLE_MAX!; _DOUBLE_MIN_FRAC#
PRINT _BIT_MIN`; _BIT_MAX`; _UBIT_MAX~`
PRINT _TRUE%; _TRUE&; _TRUE&&; _TRUE!; _TRUE#; _ONE_KB%; _ONE_KB&&; _ONE_MB!
PRINT _LONG_MAX%; _ULONG_MAX%; _UBYTE_MAX%%; _INTEGER_MIN~%; _SINGLE_MAX#; _ONE_TB&
PRINT _TRUE% + 0; _LONG_MAX% + 0; _UBYTE_MAX%% + 0

PRINT "places"
CONST k = _TRUE + 1
CONST m = _ONE_KB * 2, w = _SECS_IN_WEEK
CONST big&& = _INTEGER64_MAX, e! = _SINGLE_MAX
PRINT k; m; w; big&&; e!
DIM fx AS STRING * _SIZE_OF_OFFSET, l AS LONG, i AS INTEGER, d AS DOUBLE, t AS STRING
PRINT LEN(fx); LEN(_STR_EMPTY); "["; _STR_EMPTY; "]"
l = _LONG_MAX: i = _INTEGER_MIN: d = _DOUBLE_MIN_FRAC: t = _STR_EMPTY + "x"
PRINT l; i; d; t
IF _TRUE THEN PRINT "true"
IF _FALSE THEN PRINT "false" ELSE PRINT "not false"
IF NOT _FALSE = _TRUE THEN PRINT "NOT _FALSE is _TRUE"
DO WHILE l > _LONG_MAX - 2
    l = l - 1
LOOP
PRINT l
SELECT CASE SGN(l)
    CASE _LESS: PRINT "less"
    CASE _EQUAL: PRINT "equal"
    CASE _GREATER: PRINT "greater"
END SELECT
ON ERROR GOTO handler
ERROR _ERR_OVERFLOW
show _TRUE, _LOG_WARN
PRINT hours(_DAYS_IN_WEEK)
SYSTEM

handler:
IF ERR = _ERR_OVERFLOW THEN PRINT "overflow"; ERR
RESUME NEXT

SUB show (a AS LONG, b AS INTEGER)
    PRINT a; b; _TRUE; _SECS_IN_MIN * _MINS_IN_HOUR
    IF _TRUE THEN PRINT _ONE_MB; _KEY_F1
    CONST inSub = _ONE_KB + _TRUE
    PRINT inSub
END SUB

FUNCTION hours& (days AS LONG)
    hours& = days * _HOURS_IN_DAY
END FUNCTION
