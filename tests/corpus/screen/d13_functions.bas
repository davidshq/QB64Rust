' CSRLIN, POS, SCREEN and POINT: each result printed, and so part of the state.
DIM r AS LONG, c AS LONG
LOCATE 4, 7: r = CSRLIN: c = POS(0): PRINT r; c
PRINT CSRLIN; POS(0)
PRINT "abc"; POS(0); CSRLIN
PRINT "abc"; : PRINT POS(1); CSRLIN * 2 + POS(0)
