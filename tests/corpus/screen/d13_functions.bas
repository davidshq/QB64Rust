PRINT HEX$(SCREEN(8, 3, 1)); SCREEN(8, 3) / 2; -SCREEN(8, 3); SCREEN(8, 3) - 100
r = SCREEN(8, 3): c = SCREEN(8, 3, 1)
PRINT r; c; POS(0) + CSRLIN
LOCATE 25, 80: PRINT "x";
r = CSRLIN: c = POS(0)
