$CONSOLE:ONLY
img& = _NEWIMAGE(4, 2, 32)
_DEST img&
PSET (1, 0), _RGB32(10, 20, 30)
_DEST _CONSOLE
DIM m AS _MEM
m = _MEMIMAGE(img&)
PRINT "SIZE, TYPE, ELEMENTSIZE:"; m.SIZE; m.TYPE; m.ELEMENTSIZE
PRINT "Pixel (1, 0): "; HEX$(_MEMGET(m, m.OFFSET + 4, _UNSIGNED LONG))
PRINT "IMAGE is the handle:"; m.IMAGE = img&
END
