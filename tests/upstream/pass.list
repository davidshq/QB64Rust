# Upstream programs the new compiler passes end to end (spec testing/upstream-tests, "Upstream progress"). A
# ratchet: programs are added when they pass, never removed. Run: python tools/legacy_tests/run_legacy_tests.py
# --suite compile --qb64 target/release/qb64rust.exe --list tests/upstream/pass.list
console/test
dollar$sign$test/dollar$sign
filename/filename.extra.extension
name with spaces/test
noprompt/noprompt-continue
noprompt/noprompt-y
parens()/parens()
single'quote'test/single'quote'test
source_ordering/sub_after_main
source_ordering/sub_before_main
