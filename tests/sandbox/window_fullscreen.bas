' _FULLSCREEN and its forms read back by the functions _FULLSCREEN, _SMOOTH, _SCALEDWIDTH and _SCALEDHEIGHT
' (tests/sandbox/README.md). The test VM's display is at 100%, so a window's scaled size is its own.
SCREEN _NEWIMAGE(320, 200, 32)
_DELAY 1
OPEN "out.txt" FOR OUTPUT AS #1
PRINT #1, "at the start, _FULLSCREEN:"; _FULLSCREEN; "_SMOOTH:"; _SMOOTH
PRINT #1, "scaled size in a window:"; _SCALEDWIDTH; _SCALEDHEIGHT
PRINT #1, "_DESKTOPREFRESHRATE above 0:"; _DESKTOPREFRESHRATE > 0

_FULLSCREEN _SQUAREPIXELS
_DELAY 1
PRINT #1, "after _FULLSCREEN _SQUAREPIXELS:"; _FULLSCREEN; "_SMOOTH:"; _SMOOTH

_FULLSCREEN _STRETCH, _SMOOTH
_DELAY 1
PRINT #1, "after _FULLSCREEN _STRETCH, _SMOOTH:"; _FULLSCREEN; "_SMOOTH:"; _SMOOTH

_FULLSCREEN _OFF
_DELAY 1
PRINT #1, "after _FULLSCREEN _OFF:"; _FULLSCREEN; "_SMOOTH:"; _SMOOTH
PRINT #1, "scaled size in a window again:"; _SCALEDWIDTH; _SCALEDHEIGHT
CLOSE #1
SYSTEM
