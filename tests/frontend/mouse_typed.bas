' TEST: typed
$CONSOLE:ONLY
' The mouse functions of m3-images-fonts-mouse with their held and believed types (design D1;
' verification\v31_x01_accepted): _MOUSEINPUT, _MOUSEBUTTON, _MOUSEHIDDEN and _MOUSEDISABLED a LONG; _MOUSEX,
' _MOUSEY, _MOUSEWHEEL, _MOUSEMOVEMENTX and _MOUSEMOVEMENTY a DOUBLE; _MOUSEBUTTON and _MOUSEWHEEL with a LONG
' slot, optional for _MOUSEWHEEL
DIM i AS INTEGER, l AS LONG, s AS SINGLE, d AS DOUBLE, u AS _UNSIGNED LONG
WHILE _MOUSEINPUT: WEND
l = _MOUSEINPUT + _MOUSEBUTTON(1) + _MOUSEBUTTON(i) + _MOUSEBUTTON(s) + _MOUSEBUTTON(u)
l = _MOUSEHIDDEN + _MOUSEDISABLED
d = _MOUSEX + _MOUSEY + _MOUSEWHEEL + _MOUSEWHEEL(1) + _MOUSEWHEEL(s)
d = _MOUSEMOVEMENTX + _MOUSEMOVEMENTY
PRINT _MOUSEINPUT; HEX$(_MOUSEX); _MOUSEY + 1; HEX$(_MOUSEBUTTON(1)); _MOUSEWHEEL / 2; _MOUSEHIDDEN + 1
