$CONSOLE
$SCREENHIDE
' Verification (m4-builtins-remaining, task 2.1): the window's display statements in each form, in a program with a hidden window:
' _GLRENDER, _DISPLAYORDER, _ALLOWFULLSCREEN, _FPS, and _SMOOTH after each _ALLOWFULLSCREEN.
SCREEN _NEWIMAGE(320, 200, 32)
_GLRENDER _BEHIND
_GLRENDER _ONTOP
_GLRENDER _ONLY
_GLRENDER _BEHIND
_DISPLAYORDER _HARDWARE, _SOFTWARE
_DISPLAYORDER _SOFTWARE
_DISPLAYORDER _SOFTWARE, _HARDWARE, _HARDWARE1, _GLRENDER
_DISPLAYORDER
s0 = _SMOOTH
_ALLOWFULLSCREEN
s1 = _SMOOTH
_ALLOWFULLSCREEN _STRETCH, _SMOOTH
s2 = _SMOOTH
_ALLOWFULLSCREEN _OFF
_ALLOWFULLSCREEN _SQUAREPIXELS
_ALLOWFULLSCREEN _ALL, _ALL
_ALLOWFULLSCREEN , _SMOOTH
_ALLOWFULLSCREEN _STRETCH, _OFF
_ALLOWFULLSCREEN _OFF, OFF
_ALLOWFULLSCREEN OFF
s3 = _SMOOTH
_FPS 30
_FPS _AUTO
_FPS 1.5
n = 60: _FPS n
_DEST _CONSOLE
PRINT s0; s1; s2; s3
PRINT "ok"
SYSTEM
