' The top file of test/header: a DECLARE LIBRARY whose header, hd_beside.h, stands beside this file, as in
' RhoSigma's QB-StdArg of the QB64-PE Libraries Pack. Neither the compiler's folder nor the program's holds it.
DECLARE LIBRARY "hd_beside"
    FUNCTION hd_twice& (BYVAL v AS LONG)
END DECLARE
