
#include "manifest.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "v40_h2_large_parts.exe.manifest"

1 VERSIONINFO
FILEVERSION     70000,0,0,99999
BEGIN
