
#include "manifest.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "v40_g1_specials.exe.manifest"

1 VERSIONINFO
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName","\0"
            VALUE "FileDescription","back\slash\0"
            VALUE "FileVersion","\0"
            VALUE "InternalName","say 'hi'\0"
            VALUE "LegalCopyright","\0"
            VALUE "LegalTrademarks","ends\\0"
            VALUE "OriginalFilename","a\nb\0"
            VALUE "ProductName","\0"
            VALUE "ProductVersion","\0"
            VALUE "Comments","quote ' inside\0"
            VALUE "Web","\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
            VALUE "Translation", 0x409, 0x04E4
    END
END
