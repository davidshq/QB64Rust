
#include "manifest.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "v40_a_all_keys.exe.manifest"

1 VERSIONINFO
FILEVERSION     1,2,3,4
PRODUCTVERSION  5,6,7,8
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName","Acme Co\0"
            VALUE "FileDescription","A test file\0"
            VALUE "FileVersion","1.2.3.4 beta\0"
            VALUE "InternalName","internal\0"
            VALUE "LegalCopyright","(c) 2026\0"
            VALUE "LegalTrademarks","TM\0"
            VALUE "OriginalFilename","orig.exe\0"
            VALUE "ProductName","Product\0"
            VALUE "ProductVersion","5.6 prod\0"
            VALUE "Comments","a comment\0"
            VALUE "Web","https://example.org\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
            VALUE "Translation", 0x409, 0x04E4
    END
END
