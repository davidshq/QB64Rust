$CONSOLE:ONLY
' Verification (m2-defxxx-common-arrays, D1): which spellings of a constant bound make a static array. Each array
' is declared by DIM and then given REDIM: a static array answers with error 10 and keeps its bounds, a dynamic
' one takes the new bounds (UBOUND 20).
ON ERROR GOTO h
CONST k = 5
DIM a1(5) AS LONG
PRINT "1. 5:";
REDIM a1(20) AS LONG
PRINT UBOUND(a1)
DIM a2((5)) AS LONG
PRINT "2. (5):";
REDIM a2(20) AS LONG
PRINT UBOUND(a2)
DIM a3(2 + 3) AS LONG
PRINT "3. 2 + 3:";
REDIM a3(20) AS LONG
PRINT UBOUND(a3)
DIM a4(k) AS LONG
PRINT "4. a CONST:";
REDIM a4(20) AS LONG
PRINT UBOUND(a4)
DIM a5(k + 1) AS LONG
PRINT "5. a CONST + 1:";
REDIM a5(20) AS LONG
PRINT UBOUND(a5)
DIM a6(-(2 ^ 2) TO 10 \ 3) AS LONG
PRINT "6. -(2 ^ 2) TO 10 \ 3:";
REDIM a6(20) AS LONG
PRINT UBOUND(a6)
DIM a7(5&) AS LONG
PRINT "7. 5&:";
REDIM a7(20) AS LONG
PRINT UBOUND(a7)
DIM a8(&H5) AS LONG
PRINT "8. &H5:";
REDIM a8(20) AS LONG
PRINT UBOUND(a8)
DIM a9(5.0) AS LONG
PRINT "9. 5.0:";
REDIM a9(20) AS LONG
PRINT UBOUND(a9)
DIM a10(2.5) AS LONG
PRINT "10. 2.5:";
REDIM a10(20) AS LONG
PRINT UBOUND(a10)
DIM a11(-1 TO 5) AS LONG
PRINT "11. -1 TO 5:";
REDIM a11(20) AS LONG
PRINT UBOUND(a11)
DIM a12(1 - 2 TO 5) AS LONG
PRINT "12. 1 - 2 TO 5:";
REDIM a12(20) AS LONG
PRINT UBOUND(a12)
DIM a13(1 TO k) AS LONG
PRINT "13. 1 TO a CONST:";
REDIM a13(20) AS LONG
PRINT UBOUND(a13)
DIM a14(k TO k * 2) AS LONG
PRINT "14. a CONST TO a CONST * 2:";
REDIM a14(20) AS LONG
PRINT UBOUND(a14)
DIM a15(5, 2 + 3) AS LONG
PRINT "15. 5, 2 + 3:";
REDIM a15(20, 20) AS LONG
PRINT UBOUND(a15)
DIM a16(-5 TO -1) AS LONG
PRINT "16. -5 TO -1:";
REDIM a16(20) AS LONG
PRINT UBOUND(a16)
DIM a18(5%) AS LONG
PRINT "18. 5%:";
REDIM a18(20) AS LONG
PRINT UBOUND(a18)
DIM a19(1E1) AS LONG
PRINT "19. 1E1:";
REDIM a19(20) AS LONG
PRINT UBOUND(a19)
DIM a20(NOT -6) AS LONG
PRINT "20. NOT -6:";
REDIM a20(20) AS LONG
PRINT UBOUND(a20)
SYSTEM
h:
PRINT " [error"; ERR; "]";
RESUME NEXT
