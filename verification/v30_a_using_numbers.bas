$CONSOLE:ONLY
' Verification (step 4 of M3, measured before its design): PRINT USING with numbers. Digit fields, the point, a
' field that is too small (%), the signs before and after, **, $$, **$, the comma, the exponent with four and
' five carets, the underscore, text around a field, rounding, each numeric type, and a value that is not finite.
' Every line is between brackets so that its blanks show.
ON ERROR GOTO h
DIM i AS INTEGER, l AS LONG, s AS SINGLE, d AS DOUBLE, f AS _FLOAT, q AS _INTEGER64, u AS _UNSIGNED _INTEGER64
DIM b AS _BYTE, ub AS _UNSIGNED _BYTE, ul AS _UNSIGNED LONG
PRINT "digits"
PRINT "["; : PRINT USING "#"; 5; : PRINT "]"
PRINT "["; : PRINT USING "###"; 5; : PRINT "]"
PRINT "["; : PRINT USING "###"; -5; : PRINT "]"
PRINT "["; : PRINT USING "###"; 123; : PRINT "]"
PRINT "["; : PRINT USING "###"; 1234; : PRINT "]"
PRINT "["; : PRINT USING "###"; -123; : PRINT "]"
PRINT "["; : PRINT USING "#"; -1; : PRINT "]"
PRINT "["; : PRINT USING "###"; 0; : PRINT "]"
PRINT "the point"
PRINT "["; : PRINT USING "##.##"; 3.14159; : PRINT "]"
PRINT "["; : PRINT USING "##.##"; 0.5; : PRINT "]"
PRINT "["; : PRINT USING "##.##"; -0.5; : PRINT "]"
PRINT "["; : PRINT USING ".##"; 0.5; : PRINT "]"
PRINT "["; : PRINT USING ".##"; -0.5; : PRINT "]"
PRINT "["; : PRINT USING ".##"; 1.5; : PRINT "]"
PRINT "["; : PRINT USING "##."; 12.4; : PRINT "]"
PRINT "["; : PRINT USING "#.#"; 0; : PRINT "]"
PRINT "["; : PRINT USING "##.##"; 123.456; : PRINT "]"
PRINT "["; : PRINT USING "#.##.##"; 1.5; : PRINT "]"
PRINT "rounding"
PRINT "["; : PRINT USING "#.#"; 0.25; : PRINT "]"
PRINT "["; : PRINT USING "#.#"; 0.35; : PRINT "]"
PRINT "["; : PRINT USING "#.#"; 0.05; : PRINT "]"
PRINT "["; : PRINT USING "##"; 0.5; : PRINT "]"
PRINT "["; : PRINT USING "##"; 1.5; : PRINT "]"
PRINT "["; : PRINT USING "##"; 2.5; : PRINT "]"
PRINT "["; : PRINT USING "##"; 9.5; : PRINT "]"
PRINT "["; : PRINT USING "#"; 9.5; : PRINT "]"
PRINT "["; : PRINT USING "#.##"; 9.999; : PRINT "]"
PRINT "["; : PRINT USING "#.#"; -0.04; : PRINT "]"
PRINT "signs"
PRINT "["; : PRINT USING "+###"; 5; : PRINT "]"
PRINT "["; : PRINT USING "+###"; -5; : PRINT "]"
PRINT "["; : PRINT USING "###+"; 5; : PRINT "]"
PRINT "["; : PRINT USING "###+"; -5; : PRINT "]"
PRINT "["; : PRINT USING "###-"; 5; : PRINT "]"
PRINT "["; : PRINT USING "###-"; -5; : PRINT "]"
PRINT "["; : PRINT USING "-###"; 5; : PRINT "]"
PRINT "["; : PRINT USING "-###"; -5; : PRINT "]"
PRINT "["; : PRINT USING "+###+"; 5; : PRINT "]"
PRINT "["; : PRINT USING "+#"; 0; : PRINT "]"
PRINT "["; : PRINT USING "+.##"; 0.5; : PRINT "]"
PRINT "["; : PRINT USING "+###"; 1234; : PRINT "]"
PRINT "stars and dollars"
PRINT "["; : PRINT USING "**###"; 5; : PRINT "]"
PRINT "["; : PRINT USING "**###"; -5; : PRINT "]"
PRINT "["; : PRINT USING "**###"; 12345; : PRINT "]"
PRINT "["; : PRINT USING "**###"; 123456; : PRINT "]"
PRINT "["; : PRINT USING "$$###"; 5; : PRINT "]"
PRINT "["; : PRINT USING "$$###"; -5; : PRINT "]"
PRINT "["; : PRINT USING "$$###"; 1234; : PRINT "]"
PRINT "["; : PRINT USING "$$###"; 12345; : PRINT "]"
PRINT "["; : PRINT USING "**$###"; 5; : PRINT "]"
PRINT "["; : PRINT USING "**$###"; -5; : PRINT "]"
PRINT "["; : PRINT USING "**$###.##"; 12.5; : PRINT "]"
PRINT "["; : PRINT USING "+$$###"; 5; : PRINT "]"
PRINT "["; : PRINT USING "+**###"; 5; : PRINT "]"
PRINT "["; : PRINT USING "$###"; 5; : PRINT "]"
PRINT "["; : PRINT USING "*###"; 5; : PRINT "]"
PRINT "["; : PRINT USING "$$"; 5; : PRINT "]"
PRINT "["; : PRINT USING "**"; 5; : PRINT "]"
PRINT "["; : PRINT USING "**$"; 5; : PRINT "]"
PRINT "["; : PRINT USING "$$###-"; -5; : PRINT "]"
PRINT "the comma"
PRINT "["; : PRINT USING "#######,"; 1234567; : PRINT "]"
PRINT "["; : PRINT USING "###,###,###"; 1234567; : PRINT "]"
PRINT "["; : PRINT USING "####,.##"; 1234.5; : PRINT "]"
PRINT "["; : PRINT USING "####,.##"; 12.5; : PRINT "]"
PRINT "["; : PRINT USING "#,###.##"; 1234.5; : PRINT "]"
PRINT "["; : PRINT USING "#,###.##"; -1234.5; : PRINT "]"
PRINT "["; : PRINT USING "####.##,"; 1234.5; : PRINT "]"
PRINT "["; : PRINT USING ",###"; 5; : PRINT "]"
PRINT "["; : PRINT USING "#,"; 5; : PRINT "]"
PRINT "["; : PRINT USING "$$#,###.##"; 1234.5; : PRINT "]"
PRINT "["; : PRINT USING "**#,###"; 1234; : PRINT "]"
PRINT "["; : PRINT USING "#,###"; 123456; : PRINT "]"
PRINT "the exponent"
PRINT "["; : PRINT USING "##.##^^^^"; 1234.5; : PRINT "]"
PRINT "["; : PRINT USING "##.##^^^^"; -1234.5; : PRINT "]"
PRINT "["; : PRINT USING "##.##^^^^"; 0.00012345; : PRINT "]"
PRINT "["; : PRINT USING "#.##^^^^"; 1234.5; : PRINT "]"
PRINT "["; : PRINT USING ".##^^^^"; 1234.5; : PRINT "]"
PRINT "["; : PRINT USING "##.##^^^^^"; 1234.5; : PRINT "]"
PRINT "["; : PRINT USING "##.##^^^^^"; 1.5D+123; : PRINT "]"
PRINT "["; : PRINT USING "##.##^^^^"; 1.5D+123; : PRINT "]"
PRINT "["; : PRINT USING "##.##^^^^"; 0; : PRINT "]"
PRINT "["; : PRINT USING "+#.##^^^^"; 1234.5; : PRINT "]"
PRINT "["; : PRINT USING "#.##^^^^-"; -1234.5; : PRINT "]"
PRINT "["; : PRINT USING "##.##^^^"; 1234.5; : PRINT "]"
PRINT "["; : PRINT USING "##.##^^^^^^"; 1234.5; : PRINT "]"
PRINT "["; : PRINT USING "###^^^^"; 1234.5; : PRINT "]"
PRINT "["; : PRINT USING "#^^^^"; 9.99; : PRINT "]"
PRINT "["; : PRINT USING "##.##^^^^"; 1.5#; : PRINT "]"
PRINT "["; : PRINT USING "##.##^^^^"; 1.5##; : PRINT "]"
PRINT "the underscore and text"
PRINT "["; : PRINT USING "_###"; 5; : PRINT "]"
PRINT "["; : PRINT USING "__##"; 5; : PRINT "]"
PRINT "["; : PRINT USING "##_"; 5; : PRINT "]"
PRINT "["; : PRINT USING "a## b"; 5; : PRINT "]"
PRINT "["; : PRINT USING "Total: ###.## units"; 12.5; : PRINT "]"
PRINT "["; : PRINT USING "##%"; 5; : PRINT "]"
PRINT "["; : PRINT USING "-"; 5; : PRINT "]"
PRINT "["; : PRINT USING "## - ##"; 1; 2; : PRINT "]"
PRINT "["; : PRINT USING "(##)"; -5; : PRINT "]"
PRINT "["; : PRINT USING "#_.#"; 5; : PRINT "]"
PRINT "types"
i = -32768: PRINT "["; : PRINT USING "######"; i; : PRINT "]"
l = 2147483647: PRINT "["; : PRINT USING "###########"; l; : PRINT "]"
b = -128: PRINT "["; : PRINT USING "####"; b; : PRINT "]"
ub = 255: PRINT "["; : PRINT USING "####"; ub; : PRINT "]"
ul = 4294967295: PRINT "["; : PRINT USING "###########"; ul; : PRINT "]"
q = 9223372036854775807: PRINT "["; : PRINT USING "####################"; q; : PRINT "]"
q = -9223372036854775807: PRINT "["; : PRINT USING "####################"; q; : PRINT "]"
u = 18446744073709551615: PRINT "["; : PRINT USING "#####################"; u; : PRINT "]"
u = 18446744073709551615: PRINT "["; : PRINT USING "###,###,###,###,###,###,###,"; u; : PRINT "]"
q = 1234567: PRINT "["; : PRINT USING "##.##^^^^"; q; : PRINT "]"
q = 1234567: PRINT "["; : PRINT USING "#########.##"; q; : PRINT "]"
s = 1 / 3: PRINT "["; : PRINT USING "#.##########"; s; : PRINT "]"
d = 1 / 3: PRINT "["; : PRINT USING "#.####################"; d; : PRINT "]"
f = 1 / 3: PRINT "["; : PRINT USING "#.########################"; f; : PRINT "]"
s = 16777217: PRINT "["; : PRINT USING "##########"; s; : PRINT "]"
s = 1E+20: PRINT "["; : PRINT USING "###"; s; : PRINT "]"
d = 1D+30: PRINT "["; : PRINT USING "###"; d; : PRINT "]"
d = 1D+300: PRINT "["; : PRINT USING "###.#"; d; : PRINT "]"
s = 0.1: PRINT "["; : PRINT USING "#.####################"; s; : PRINT "]"
d = 123456789012345678#: PRINT "["; : PRINT USING "######################"; d; : PRINT "]"
PRINT "not finite"
d = 0: d = 1 / d: PRINT "["; : PRINT USING "###.##"; d; : PRINT "]"
d = -d: PRINT "["; : PRINT USING "###.##"; d; : PRINT "]"
d = 0: d = d / d: PRINT "["; : PRINT USING "###.##"; d; : PRINT "]"
s = 0: s = 1 / s: PRINT "["; : PRINT USING "##.##^^^^"; s; : PRINT "]"
SYSTEM
h:
PRINT "<error"; ERR; ">";
RESUME NEXT
