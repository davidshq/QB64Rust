$CONSOLE:ONLY
' Verification (m4-handlers-logging-checking, task 1.2): the handler chain: _NEWHANDLER two and three deep,
' _LASTHANDLER back down and with nothing kept, ON ERROR GOTO 0 then _LASTHANDLER, a plain ON ERROR GOTO label
' between, _NEWHANDLER in a SUB and a FUNCTION, and an error with no handler left at the end.
ON ERROR GOTO ha
ERROR 5
ON ERROR GOTO _NEWHANDLER hb
ERROR 6
ON ERROR GOTO _NEWHANDLER hc
ERROR 7
ON ERROR GOTO _LASTHANDLER
ERROR 8
ON ERROR GOTO _LASTHANDLER
ERROR 9
PRINT "1. three deep and back"
ON ERROR GOTO _LASTHANDLER
ON ERROR GOTO _LASTHANDLER
ON ERROR GOTO ha
ERROR 10
PRINT "2. LASTHANDLER with nothing kept, then ha"
ON ERROR GOTO _NEWHANDLER hb
ON ERROR GOTO 0
ON ERROR GOTO _LASTHANDLER
ON ERROR GOTO hc
ERROR 19
ON ERROR GOTO _LASTHANDLER
PRINT "3. after ON ERROR GOTO 0"
ON ERROR GOTO ha
ON ERROR GOTO _NEWHANDLER hb
ON ERROR GOTO hc
ERROR 12
ON ERROR GOTO _LASTHANDLER
ERROR 13
PRINT "4. a plain label between"
s
ERROR 14
PRINT "5. f ="; f(2)
ERROR 15
ON ERROR GOTO _NEWHANDLER hb
ON ERROR GOTO _NEWHANDLER hb
ON ERROR GOTO _LASTHANDLER
ERROR 16
ON ERROR GOTO _LASTHANDLER
ERROR 17
PRINT "6. the same label twice"
ON ERROR GOTO _LASTHANDLER
ON ERROR GOTO _LASTHANDLER
ERROR 18
PRINT "7. unhandled"
SYSTEM

ha:
PRINT "ha"; ERR
RESUME NEXT
hb:
PRINT "hb"; ERR
RESUME NEXT
hc:
PRINT "hc"; ERR
RESUME NEXT

SUB s
    ON ERROR GOTO _NEWHANDLER hb
    ERROR 20
    ON ERROR GOTO _NEWHANDLER hc
    ERROR 21
    ON ERROR GOTO _LASTHANDLER
    ERROR 22
    ON ERROR GOTO _LASTHANDLER
END SUB

FUNCTION f (n)
    ON ERROR GOTO _NEWHANDLER hc
    ERROR 30 + n
    ON ERROR GOTO _LASTHANDLER
    f = n * 2
END FUNCTION
