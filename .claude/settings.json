{
  "enableArtifact": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/hooks/guard_tool.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
